<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GameLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLauncher"
    xmlns:models="using:GameLauncher.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="游戏启动器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,16,24,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="12">
                <TextBlock Text="我的游戏"
                           Style="{StaticResource TitleTextBlockStyle}"
                           FontSize="28"/>
                <AutoSuggestBox x:Name="SearchBox"
                                PlaceholderText="搜索游戏..."
                                Width="400"
                                TextChanged="SearchBox_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SelectModeButton"
                        Click="SelectModeButton_Click"
                        Style="{StaticResource DefaultButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE762;"/>
                        <TextBlock Text="批量操作"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BatchDeleteButton"
                        Click="BatchDeleteButton_Click"
                        Style="{StaticResource DefaultButtonStyle}"
                        Visibility="Collapsed"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE107;"/>
                        <TextBlock Text="删除选中"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CancelSelectButton"
                        Click="CancelSelectButton_Click"
                        Style="{StaticResource DefaultButtonStyle}"
                        Visibility="Collapsed">
                    <TextBlock Text="取消"/>
                </Button>
                <Button x:Name="AddGameButton"
                        Click="AddGameButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;"/>
                        <TextBlock Text="添加游戏"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto">
            <GridView x:Name="GamesGridView"
                      Padding="24,16"
                      ItemsSource="{x:Bind FilteredGames}"
                      SelectionMode="None"
                      SelectionChanged="GamesGridView_SelectionChanged">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="200"
                                Height="320"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                PointerEntered="GameCard_PointerEntered"
                                PointerExited="GameCard_PointerExited"
                                PointerPressed="GameCard_PointerPressed"
                                x:Name="GameCardBorder">

                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock x:Name="RunningIndicator"
                                               Text="● 运行中"
                                               FontSize="12"
                                               Foreground="{ThemeResource SystemAccentColor}"
                                               Visibility="Collapsed"/>
                                </Grid>

                                <Image Grid.Row="1"
                                       x:Name="GameIcon"
                                       Source="{Binding IconSource, FallbackValue=ms-appx:///Assets/StoreLogo.png}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Margin="0,0,0,0"/>

                                <TextBlock Grid.Row="2"
                                           Text="{Binding Name}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="3"
                                           Text="{Binding Description, FallbackValue='暂无描述'}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,4"
                                           Height="28"/>

                                <Grid Grid.Row="4" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Name="LaunchCountText"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding LaunchCount}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE916;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <TextBlock x:Name="PlayTimeText"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding TotalPlayTime}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="5" Spacing="8">
                                    <Button x:Name="LaunchButton"
                                            Click="LaunchButton_Click"
                                            PointerPressed="Button_PointerPressed"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Height="32">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                            <TextBlock Text="启动"/>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="EditButton"
                                                Click="EditButton_Click"
                                                PointerPressed="Button_PointerPressed"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                Width="76"
                                                Height="32">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE104;" FontSize="14"/>
                                                <TextBlock Text="编辑"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="DeleteButton"
                                                Click="DeleteButton_Click"
                                                PointerPressed="Button_PointerPressed"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                Width="76"
                                                Height="32">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE107;" FontSize="14"/>
                                                <TextBlock Text="删除"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

        <Grid x:Name="EmptyState"
              Grid.Row="1"
              Visibility="Collapsed"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">
            <StackPanel Spacing="16">
                <FontIcon Glyph="&#xE8C7;"
                          FontSize="64"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="还没有添加任何游戏"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="点击右上角的「添加游戏」按钮开始使用"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>