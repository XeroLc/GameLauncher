<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GameLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLauncher"
    xmlns:models="using:GameLauncher.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="游戏启动器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,16,24,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="12">
                <TextBlock Text="我的游戏"
                           Style="{StaticResource TitleTextBlockStyle}"
                           FontSize="28"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox"
                                    PlaceholderText="搜索游戏..."
                                    Width="400"
                                    TextChanged="SearchBox_TextChanged"/>
                    <ComboBox x:Name="SortComboBox"
                              Grid.Column="1"
                              Width="160"
                              SelectionChanged="SortComboBox_SelectionChanged"
                              Margin="12,0,0,0">
                        <ComboBoxItem Content="名称" Tag="Name"/>
                        <ComboBoxItem Content="启动次数" Tag="LaunchCount"/>
                        <ComboBoxItem Content="游戏时长" Tag="TotalPlayTime"/>
                        <ComboBoxItem Content="添加时间" Tag="CreatedAt" IsSelected="True"/>
                        <ComboBoxItem Content="最近运行" Tag="LastRunTime"/>
                    </ComboBox>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="标签筛选：" 
                               VerticalAlignment="Center" 
                               FontSize="12" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="TagFilterComboBox" 
                              Width="200" 
                              PlaceholderText="全部标签"
                              SelectionChanged="TagFilterComboBox_SelectionChanged"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ThemeToggleButton"
                        Click="ThemeToggleButton_Click"
                        Style="{StaticResource DefaultButtonStyle}">
                    <FontIcon x:Name="ThemeIcon" Glyph="&#xE708;" FontSize="16"/>
                </Button>
                <Button x:Name="SelectModeButton"
                        Click="SelectModeButton_Click"
                        Style="{StaticResource DefaultButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE762;"/>
                        <TextBlock Text="批量操作"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BatchDeleteButton"
                        Click="BatchDeleteButton_Click"
                        Style="{StaticResource DefaultButtonStyle}"
                        Visibility="Collapsed"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE107;"/>
                        <TextBlock Text="删除选中"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CancelSelectButton"
                        Click="CancelSelectButton_Click"
                        Style="{StaticResource DefaultButtonStyle}"
                        Visibility="Collapsed">
                    <TextBlock Text="取消"/>
                </Button>
                <Button x:Name="AddGameButton"
                        Click="AddGameButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;"/>
                        <TextBlock Text="添加游戏"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto">
            <GridView x:Name="GamesGridView"
                      Padding="24,16"
                      ItemsSource="{x:Bind FilteredGames}"
                      SelectionMode="None"
                      SelectionChanged="GamesGridView_SelectionChanged"
                      AllowDrop="True"
                      DragOver="GamesGridView_DragOver"
                      Drop="GamesGridView_Drop">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="240"
                                Height="340"
                                CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                PointerEntered="GameCard_PointerEntered"
                                PointerExited="GameCard_PointerExited"
                                PointerPressed="GameCard_PointerPressed"
                                x:Name="GameCardBorder"
                                Margin="4">

                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="160"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Border CornerRadius="12,12,0,0"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Image x:Name="GameIcon"
                                               Source="{Binding IconSource, FallbackValue=ms-appx:///Assets/StoreLogo.png}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Width="100"
                                               Height="100"
                                               Margin="0"/>
                                    </Border>

                                    <Grid x:Name="RunningIndicatorGrid"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          Margin="8,8,0,0"
                                          Visibility="Collapsed">
                                        <Border Background="{ThemeResource SystemAccentColor}"
                                                CornerRadius="4"
                                                Padding="6,3">
                                            <TextBlock Text="运行中"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="1" Margin="14,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Name}"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               TextAlignment="Left"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"/>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Description, FallbackValue='暂无描述'}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextAlignment="Left"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,2,0,8"/>

                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock x:Name="LaunchCountText"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding LaunchCount}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE916;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock x:Name="PlayTimeText"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding TotalPlayTime}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button x:Name="LaunchButton"
                                            Grid.Row="3"
                                            Click="LaunchButton_Click"
                                            PointerPressed="Button_PointerPressed"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Height="36">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                            <TextBlock Text="启动游戏"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

        <Grid x:Name="EmptyState"
              Grid.Row="1"
              Visibility="Collapsed"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">
            <StackPanel Spacing="16">
                <FontIcon Glyph="&#xE8C7;"
                          FontSize="64"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="还没有添加任何游戏"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="点击右上角的「添加游戏」按钮开始使用"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="24,16">
            <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.5">
                <TextBlock Text="v2.0" 
                           FontSize="12" 
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="|" 
                           FontSize="12" 
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="@XeroLc" 
                           FontSize="12" 
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>