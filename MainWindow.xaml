<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GameLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLauncher"
    xmlns:models="using:GameLauncher.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="游戏启动器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,16,24,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="我的游戏"
                       Style="{StaticResource TitleTextBlockStyle}"
                       FontSize="28"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    x:Name="AddGameButton"
                    Click="AddGameButton_Click"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;"/>
                    <TextBlock Text="添加游戏"/>
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto">
            <GridView x:Name="GamesGridView"
                      Padding="24,16"
                      ItemsSource="{x:Bind Games}"
                      SelectionMode="None">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:Game">
                        <Border Width="200"
                                Height="280"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">

                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Grid.Row="0"
                                       Source="ms-appx:///Assets/StoreLogo.png"
                                       Stretch="Uniform"
                                       Width="120"
                                       Height="120"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,8,0,8"/>

                                <TextBlock Grid.Row="1"
                                           Text="{x:Bind Name}"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2"
                                           Text="{x:Bind Description, FallbackValue='暂无描述'}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,8"
                                           Height="32"/>

                                <StackPanel Grid.Row="3" Spacing="8">
                                    <Button x:Name="LaunchButton"
                                            Click="LaunchButton_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Height="32">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                            <TextBlock Text="启动"/>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="EditButton"
                                                Click="EditButton_Click"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                Width="76"
                                                Height="32">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE104;" FontSize="14"/>
                                                <TextBlock Text="编辑"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="DeleteButton"
                                                Click="DeleteButton_Click"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                Width="76"
                                                Height="32">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE107;" FontSize="14"/>
                                                <TextBlock Text="删除"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

        <Grid x:Name="EmptyState"
              Grid.Row="1"
              Visibility="Collapsed"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">
            <StackPanel Spacing="16">
                <FontIcon Glyph="&#xE8C7;"
                          FontSize="64"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="还没有添加任何游戏"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="点击右上角的「添加游戏」按钮开始使用"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>