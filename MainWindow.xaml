<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GameLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLauncher"
    xmlns:models="using:GameLauncher.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="游戏启动器">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid IsHitTestVisible="False">
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="400" Opacity="0.12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="500" Height="300" Opacity="0.06">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Width="400" Height="400" Opacity="0.05">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ViewChanged="MainScrollViewer_ViewChanged">
            <GridView x:Name="GamesGridView"
                      Padding="24,16"
                      ItemsSource="{x:Bind FilteredGames}"
                      SelectionMode="None"
                      SelectionChanged="GamesGridView_SelectionChanged"
                      AllowDrop="True"
                      DragOver="GamesGridView_DragOver"
                      Drop="GamesGridView_Drop">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="240"
                                Height="340"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Background="{StaticResource FrostedGlassCardBrush}"
                                BorderBrush="{StaticResource FrostBorderBrush}"
                                BorderThickness="1"
                                PointerEntered="GameCard_PointerEntered"
                                PointerExited="GameCard_PointerExited"
                                PointerPressed="GameCard_PointerPressed"
                                x:Name="GameCardBorder"
                                Margin="4">

                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="160"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Border CornerRadius="16,16,0,0"
                                            Background="{StaticResource FrostedGlassBackgroundBrush}">
                                        <Image x:Name="GameIcon"
                                               Source="{Binding IconSource, FallbackValue=ms-appx:///Assets/StoreLogo.png}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Width="100"
                                               Height="100"
                                               Margin="0"/>
                                    </Border>

                                    <Grid x:Name="RunningIndicatorGrid"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          Margin="8,8,0,0"
                                          Visibility="Collapsed">
                                        <Border Background="{ThemeResource SystemAccentColor}"
                                                CornerRadius="4"
                                                Padding="6,3">
                                            <TextBlock Text="运行中"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="1" Margin="14,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Name}"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               TextAlignment="Left"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"/>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Description, FallbackValue='暂无描述'}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextAlignment="Left"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,2,0,8"/>

                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock x:Name="LaunchCountText"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding LaunchCount}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE916;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock x:Name="PlayTimeText"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding TotalPlayTime}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="3">
                                        <Button x:Name="LaunchButton"
                                                Click="LaunchButton_Click"
                                                PointerPressed="Button_PointerPressed"
                                                Style="{StaticResource FrostedAccentButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Height="36">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                                <TextBlock Text="启动游戏"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="StopButton"
                                                Click="StopButton_Click"
                                                PointerPressed="Button_PointerPressed"
                                                Style="{StaticResource FrostedStopButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Height="36"
                                                Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                                                <TextBlock Text="终止游戏"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

        <Grid x:Name="EmptyState"
              Visibility="Collapsed"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">
            <Border Background="{StaticResource FrostedGlassCardBrush}"
                    BorderBrush="{StaticResource FrostBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="40,32">
            <StackPanel Spacing="16">
                <FontIcon Glyph="&#xE8C7;"
                          FontSize="64"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="还没有添加任何游戏"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="点击右上角的「添加游戏」按钮开始使用"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
            </Border>
        </Grid>

        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="24,16">
            <Button Click="VersionWatermark_Click" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="4">
                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.5">
                    <TextBlock Text="v3.0"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="|"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="@XeroLc"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border x:Name="NavBar"
                VerticalAlignment="Top"
                Margin="16,8,16,0"
                Padding="24,16,24,16"
                CornerRadius="12"
                Background="{StaticResource FrostedGlassNavFloatingBrush}"
                BorderBrush="{StaticResource FrostBorderBrush}"
                BorderThickness="1"
                Canvas.ZIndex="10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="12">
                    <TextBlock Text="我的游戏"
                               Style="{StaticResource TitleTextBlockStyle}"
                               FontSize="28"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="SearchBox"
                                        PlaceholderText="搜索游戏..."
                                        Width="400"
                                        TextChanged="SearchBox_TextChanged"/>
                        <ComboBox x:Name="SortComboBox"
                                  Grid.Column="1"
                                  Width="160"
                                  SelectionChanged="SortComboBox_SelectionChanged"
                                  Margin="12,0,0,0">
                            <ComboBoxItem Content="名称" Tag="Name"/>
                            <ComboBoxItem Content="启动次数" Tag="LaunchCount"/>
                            <ComboBoxItem Content="游戏时长" Tag="TotalPlayTime"/>
                            <ComboBoxItem Content="添加时间" Tag="CreatedAt" IsSelected="True"/>
                            <ComboBoxItem Content="最近运行" Tag="LastRunTime"/>
                        </ComboBox>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="标签筛选："
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="TagFilterComboBox"
                                  Width="200"
                                  PlaceholderText="全部标签"
                                  SelectionChanged="TagFilterComboBox_SelectionChanged"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SettingsButton"
                            Click="SettingsButton_Click"
                            Style="{StaticResource FrostedDefaultButtonStyle}">
                        <FontIcon Glyph="&#xE713;"/>
                    </Button>
                    <Button x:Name="SelectModeButton"
                            Click="SelectModeButton_Click"
                            Style="{StaticResource FrostedDefaultButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE762;"/>
                            <TextBlock Text="批量操作"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BatchDeleteButton"
                            Click="BatchDeleteButton_Click"
                            Style="{StaticResource FrostedDefaultButtonStyle}"
                            Visibility="Collapsed"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE107;"/>
                            <TextBlock Text="删除选中"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelSelectButton"
                            Click="CancelSelectButton_Click"
                            Style="{StaticResource FrostedDefaultButtonStyle}"
                            Visibility="Collapsed">
                        <TextBlock Text="取消"/>
                    </Button>
                    <Button x:Name="AddGameButton"
                            Click="AddGameButton_Click"
                            Style="{StaticResource FrostedAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;"/>
                            <TextBlock Text="添加游戏"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="LoadingOverlay"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="#88000000"
              Canvas.ZIndex="100">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource FrostedGlassDialogBrush}"
                    BorderBrush="{StaticResource FrostBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="40,24">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="50" Height="50"
                                  Foreground="{ThemeResource SystemAccentColor}"/>
                    <TextBlock Text="正在创建游戏文件"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="正在生成游戏数据文件，请稍候..."
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
