<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GameLauncher.Views.CollectionManageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="管理收藏夹"
    PrimaryButtonText="完成"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
        <StackPanel Spacing="16" Width="420">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="NewCollectionTextBox"
                         Grid.Column="0"
                         Header="新建收藏夹"
                         PlaceholderText="输入收藏夹名称"
                         KeyDown="NewCollectionTextBox_KeyDown"/>

                <Button x:Name="AddCollectionButton"
                        Grid.Column="1"
                        Click="AddCollectionButton_Click"
                        Style="{StaticResource FrostedAccentButtonStyle}"
                        ToolTipService.ToolTip="添加"
                        VerticalAlignment="Bottom"
                        Height="36">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                </Button>
            </Grid>

            <TextBlock Text="我的收藏夹"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,8,0,0"/>

            <ListView x:Name="CollectionsListView" MaxHeight="250">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE8B7;"
                                      FontSize="16"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       FontSize="12"
                                       Margin="0,0,8,0">
                                <Run Text="{Binding GameCount}"/>
                                <Run Text=" 个游戏"/>
                            </TextBlock>

                            <Button Grid.Column="3"
                                    Content="&#xE8AC;"
                                    Tag="{Binding}"
                                    Click="RenameCollectionButton_Click"
                                    Background="Transparent"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="0"
                                    Padding="6,2"
                                    MinWidth="0"
                                    MinHeight="0"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    ToolTipService.ToolTip="重命名收藏夹"/>

                            <Button Grid.Column="4"
                                    Content="✕"
                                    Tag="{Binding}"
                                    Click="DeleteCollectionButton_Click"
                                    Background="Transparent"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    BorderThickness="0"
                                    Padding="6,2"
                                    MinWidth="0"
                                    MinHeight="0"
                                    FontSize="12"
                                    ToolTipService.ToolTip="删除收藏夹"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 内联重命名面板 -->
            <StackPanel x:Name="RenamePanel" Visibility="Collapsed" Spacing="8">
                <TextBlock Text="重命名收藏夹" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="14"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RenameTextBox"
                             Grid.Column="0"
                             PlaceholderText="输入新名称"
                             KeyDown="RenameTextBox_KeyDown"/>
                    <Button x:Name="ConfirmRenameButton"
                            Grid.Column="1"
                            Click="ConfirmRenameButton_Click"
                            Style="{StaticResource FrostedAccentButtonStyle}"
                            Content="保存"
                            Height="36"/>
                    <Button x:Name="CancelRenameButton"
                            Grid.Column="2"
                            Click="CancelRenameButton_Click"
                            Style="{StaticResource FrostedDefaultButtonStyle}"
                            Content="取消"
                            Height="36"
                            Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>

            <!-- 内联删除确认面板 -->
            <StackPanel x:Name="DeleteConfirmPanel" Visibility="Collapsed" Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="14">
                    <Run Text="确定要删除收藏夹「"/>
                    <Run x:Name="DeleteItemName" Text=""/>
                    <Run Text="」吗？该收藏夹中的游戏不会被删除。"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="ConfirmDeleteButton"
                            Click="ConfirmDeleteButton_Click"
                            Style="{StaticResource FrostedAccentButtonStyle}"
                            Content="删除"
                            Height="36"/>
                    <Button x:Name="CancelDeleteButton"
                            Click="CancelDeleteButton_Click"
                            Style="{StaticResource FrostedDefaultButtonStyle}"
                            Content="取消"
                            Height="36"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>