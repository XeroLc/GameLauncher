<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GameLauncher.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="设置"
    PrimaryButtonText="关闭"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
        <StackPanel Spacing="24" Width="400">
            <TextBlock Text="显示设置"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,8"/>

            <ToggleSwitch x:Name="HideUnavailableGamesToggle"
                          Header="隐藏不可用游戏"
                          OffContent="显示所有游戏（包括路径不存在）"
                          OnContent="隐藏路径不存在的游戏卡片"
                          Toggled="HideUnavailableGamesToggle_Toggled"/>

            <TextBlock Text="当开启此选项时，如果游戏可执行文件路径不存在（例如外接硬盘未插入），对应的游戏卡片将不会显示。"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,-16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
