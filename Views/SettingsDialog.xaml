<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GameLauncher.Views.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="设置"
    PrimaryButtonText="关闭"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
        <StackPanel Spacing="24" Width="420">
            <TextBlock Text="显示设置"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,8"/>

            <ToggleSwitch x:Name="HideUnavailableGamesToggle"
                          Header="隐藏不可用游戏"
                          OffContent="显示所有游戏（包括路径不存在）"
                          OnContent="隐藏路径不存在的游戏卡片"
                          Toggled="HideUnavailableGamesToggle_Toggled"/>

            <TextBlock Text="当开启此选项时，如果游戏可执行文件路径不存在（例如外接硬盘未插入），对应的游戏卡片将不会显示。"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,-16,0,0"/>

            <Border Height="1" Background="{ThemeResource CardStrokeColorDefault}" Margin="0,-8,0,-8"/>

            <TextBlock Text="自动扫描"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,0"/>

            <ToggleSwitch x:Name="AutoScanToggle"
                          Header="启动时自动扫描新游戏"
                          OffContent="关闭"
                          OnContent="开启"
                          Toggled="AutoScanToggle_Toggled"/>

            <Border x:Name="ScanPathsPanel"
                    BorderBrush="{ThemeResource CardStrokeColorDefault}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefault}"
                    Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="扫描路径"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="AddScanPathButton"
                                Click="AddScanPathButton_Click"
                                Style="{StaticResource FrostedAccentButtonStyle}"
                                Width="32" Height="32"
                                Padding="4">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                    <ListView x:Name="ScanPathListView"
                              ItemsSource="{x:Bind _scanPaths}"
                              SelectionMode="None"
                              MaxHeight="200">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               FontSize="13"/>
                                    <Button Grid.Column="1"
                                            Click="RemoveScanPathButton_Click"
                                            Style="{StaticResource FrostedDefaultButtonStyle}"
                                            Width="28" Height="28"
                                            Padding="2"
                                            Tag="{Binding}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <TextBlock Text="启动时将在设定的路径中静默扫描 .gmd 文件，发现新游戏时将弹出通知。"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,-16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>