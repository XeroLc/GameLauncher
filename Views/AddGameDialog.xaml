<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GameLauncher.Views.AddGameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="添加游戏"
    PrimaryButtonText="保存"
    SecondaryButtonText="取消"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Padding="8" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- .gmd文件快速添加 -->
            <Grid Grid.Row="0" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="快速添加（从.gmd文件）" 
                           Style="{ThemeResource BaseTextBlockStyle}"/>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GmdPathTextBox" 
                             Grid.Column="0"
                             PlaceholderText="选择.gmd文件以自动填充游戏信息"
                             IsReadOnly="True"/>
                    <Button x:Name="BrowseGmdButton"
                            Grid.Column="1"
                            Click="BrowseGmdButton_Click"
                            ToolTipService.ToolTip="选择.gmd文件"
                            Style="{StaticResource FrostedDefaultButtonStyle}"
                            Content="选择.gmd"/>
                </Grid>
            </Grid>

            <!-- 游戏名称 -->
            <TextBox x:Name="GameNameTextBox" 
                     Grid.Row="1"
                     Header="游戏名称" 
                     PlaceholderText="请输入游戏名称"/>

            <!-- 游戏路径 -->
            <Grid Grid.Row="2" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="游戏路径" 
                           Style="{ThemeResource BaseTextBlockStyle}"/>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExecutablePathTextBox" 
                             Grid.Column="0"
                             PlaceholderText="选择游戏可执行文件"
                             IsReadOnly="True"/>
                    <Button x:Name="BrowseButton"
                            Grid.Column="1"
                            Click="BrowseButton_Click"
                            ToolTipService.ToolTip="浏览文件"
                            Style="{StaticResource FrostedDefaultButtonStyle}"
                            Content="浏览..."/>
                </Grid>
            </Grid>

            <!-- 图标路径 -->
            <Grid Grid.Row="3" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="游戏图标（可选）" 
                           Style="{ThemeResource BaseTextBlockStyle}"/>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="IconPathTextBox" 
                             Grid.Column="0"
                             PlaceholderText="选择游戏图标"
                             IsReadOnly="True"/>
                    <Button x:Name="BrowseIconButton"
                            Grid.Column="1"
                            Click="BrowseIconButton_Click"
                            ToolTipService.ToolTip="浏览图标"
                            Style="{StaticResource FrostedDefaultButtonStyle}">
                        <FontIcon Glyph="&#xE8B9;" FontSize="16"/>
                    </Button>
                </Grid>
            </Grid>

            <!-- 游戏描述 -->
            <TextBox x:Name="DescriptionTextBox" 
                     Grid.Row="4"
                     Header="游戏描述（可选）" 
                     PlaceholderText="请输入游戏描述"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="80"/>

            <!-- 标签管理 -->
            <StackPanel Grid.Row="5" Spacing="8">
                <TextBlock Text="标签管理" 
                           Style="{ThemeResource SubtitleTextBlockStyle}" 
                           FontSize="16"/>

                <TextBlock Text="为游戏添加标签，方便分类和查找" 
                           Style="{ThemeResource BodyTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                           FontSize="13"/>

                <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TagInputTextBox"
                                 Grid.Column="0"
                                 Header="输入新标签"
                                 PlaceholderText="输入标签名称或从下拉菜单选择"
                                 KeyDown="TagInputTextBox_KeyDown"/>

                        <ComboBox x:Name="TagComboBox"
                                  Grid.Column="1"
                                  Width="140"
                                  Header="选择已有标签"
                                  PlaceholderText="选择标签"
                                  SelectionChanged="TagComboBox_SelectionChanged"
                                  Margin="0,0,0,0"/>
                    </Grid>

                    <Button x:Name="AddTagButton"
                            Grid.Column="1"
                            Click="AddTagButton_Click"
                            Style="{StaticResource FrostedAccentButtonStyle}"
                            ToolTipService.ToolTip="添加标签"
                            Height="58"
                            VerticalAlignment="Bottom">
                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                    </Button>
                </Grid>

                <ItemsControl x:Name="TagsItemsControl" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5" HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FrostedAccentTagStyle}"
                                    Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding}" 
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               FontSize="13"/>
                                    <Button Content="✕" 
                                            Click="RemoveTagButton_Click" 
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="2,0,2,0"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 收藏夹选择 -->
            <StackPanel Grid.Row="6" Spacing="8">
                <TextBlock Text="收藏夹" 
                           Style="{ThemeResource SubtitleTextBlockStyle}" 
                           FontSize="16"/>
                <ItemsControl x:Name="CollectionsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" 
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,0,16,6"
                                      FontSize="14"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 预览图片 -->
            <StackPanel Grid.Row="7" Spacing="8">
                <TextBlock Text="游戏预览图" 
                           Style="{ThemeResource SubtitleTextBlockStyle}" 
                           FontSize="16"/>

                <TextBlock Text="添加游戏预览图片（支持多选）" 
                           Style="{ThemeResource BodyTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                           FontSize="13"/>

                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ImageCountTextBlock" 
                               Grid.Column="0"
                               Text="{x:Bind ImageCountDisplay, Mode=OneWay}" 
                               Style="{ThemeResource BodyTextBlockStyle}"/>

                    <Button x:Name="AddPreviewImageButton"
                            Grid.Column="1"
                            Click="AddPreviewImageButton_Click"
                            Style="{StaticResource FrostedDefaultButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="添加图片"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 图片预览列表 -->
                <ItemsControl x:Name="PreviewImagesItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource FrostedGlassCardBrush}"
                                    BorderBrush="{StaticResource FrostBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8"
                                    Margin="0,0,8,8"
                                    Width="180" Height="140">
                                <Grid>
                                    <Image Source="{Binding}" 
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                    <Button Content="✕" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Top"
                                            Click="DeletePreviewImageButton_Click"
                                            Background="{ThemeResource SystemFillColorCriticalBrush}"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            BorderThickness="0"
                                            Padding="4,2"
                                            MinWidth="0"
                                            MinHeight="0"
                                            FontSize="12"
                                            Margin="4"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>
