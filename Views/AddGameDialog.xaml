<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GameLauncher.Views.AddGameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLauncher.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="添加游戏"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Width="400" Spacing="12">
        <TextBlock Text="游戏名称"/>
        <TextBox x:Name="GameNameTextBox" PlaceholderText="请输入游戏名称"/>

        <TextBlock Text="游戏路径"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ExecutablePathTextBox" Grid.Column="0" PlaceholderText="选择游戏可执行文件" IsReadOnly="True" Margin="0,0,8,0"/>
            <Button x:Name="BrowseButton" Grid.Column="1" Click="BrowseButton_Click" Content="浏览" Width="80" Height="32"/>
        </Grid>

        <TextBlock Text="游戏图标（可选）"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="IconPathTextBox" Grid.Column="0" PlaceholderText="选择图标文件（PNG、JPG等）" IsReadOnly="True" Margin="0,0,8,0"/>
            <Button x:Name="BrowseIconButton" Grid.Column="1" Click="BrowseIconButton_Click" Content="浏览" Width="80" Height="32"/>
        </Grid>

        <TextBlock Text="游戏描述（可选）"/>
        <TextBox x:Name="DescriptionTextBox" PlaceholderText="请输入游戏描述" AcceptsReturn="True" TextWrapping="Wrap" Height="80" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
</ContentDialog>