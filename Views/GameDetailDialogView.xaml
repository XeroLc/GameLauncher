<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GameLauncher.Views.GameDetailDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLauncher.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="游戏详情"
    CloseButtonText="关闭"
    DefaultButton="Close"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
        <StackPanel Width="450" Spacing="16">

            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GameNameText"
                               Text="{x:Bind GameName}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                        Width="48"
                        Height="48"
                        CornerRadius="8"
                        VerticalAlignment="Center"
                        Background="{StaticResource FrostedGlassCardBrush}"
                        BorderBrush="{StaticResource FrostBorderBrush}"
                        BorderThickness="1">
                                        <Image x:Name="GameIcon"
                           Source="{x:Bind GameIconSource}"
                           Stretch="Uniform"/>
                    </Border>
                </Grid>

                <Border Height="1" Background="{StaticResource FrostBorderBrush}"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="游戏描述" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <TextBlock x:Name="DescriptionText"
                           Text="{x:Bind GameDescription, FallbackValue='暂无描述'}"
                           TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="游戏标签" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <Border BorderBrush="{StaticResource FrostBorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource FrostedGlassCardBrush}"
                        CornerRadius="8"
                        MinHeight="40"
                        Padding="8">
                    <ItemsControl x:Name="TagsItemsControl" ItemsSource="{x:Bind Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FrostedAccentTagStyle}"
                                        Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <Border BorderBrush="{StaticResource FrostBorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource FrostedGlassCardBrush}"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                        <TextBlock Text="启动次数：" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind LaunchCount}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE916;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                        <TextBlock Text="游戏时长：" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind PlayTimeDisplay}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="添加时间：" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind CreatedTimeDisplay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="游戏预览" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <Border BorderBrush="{StaticResource FrostBorderBrush}"
                        BorderThickness="1"
                        Background="{StaticResource FrostedGlassCardBrush}"
                        CornerRadius="8"
                        MinHeight="100">
                    <GridView x:Name="PreviewImagesItemsControl"
                              ItemsSource="{x:Bind ImageSources}"
                              Padding="4"
                              SelectionMode="None"
                              IsItemClickEnabled="False">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="130" Height="80" Margin="4"
                                      Tapped="Image_Tapped"
                                      PointerEntered="Image_PointerEntered"
                                      PointerExited="Image_PointerExited">
                                    <Border CornerRadius="4"
                                            Background="{StaticResource FrostedGlassCardBrush}">
                                        <Image x:Name="InnerImage" Source="{Binding}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border CornerRadius="4"
                                            Background="{StaticResource FrostedGlassCardBrush}"
                                            Opacity="0.85"
                                            Visibility="Collapsed"
                                            x:Name="HoverOverlay">
                                        <Grid>
                                            <FontIcon Glyph="&#xE8A3;" FontSize="24"
                                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Border>
            </StackPanel>

            <Grid x:Name="ImageOverlay"
                  Visibility="Collapsed"
                  Background="#99000000"
                  Tapped="ImageOverlay_Tapped"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Canvas.ZIndex="100"
                  Opacity="0">
                <Border x:Name="LargePreviewBorder"
                        CornerRadius="12"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420"
                        MaxHeight="320"
                        BorderBrush="{StaticResource FrostBorderBrush}"
                        BorderThickness="1"
                        Padding="4"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="PreviewScaleTransform" ScaleX="0.5" ScaleY="0.5"/>
                    </Border.RenderTransform>
                    <Image x:Name="LargePreviewImage"
                           Stretch="Uniform"/>
                </Border>
            </Grid>

            <StackPanel Margin="0,8,0,0" Spacing="10">
                <!-- 第一行：删除 | 打开路径 | 编辑 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="DeleteButton"
                            Grid.Column="0"
                            Click="DeleteButton_Click"
                            Style="{StaticResource FrostedStopButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE107;" FontSize="14"/>
                            <TextBlock Text="删除"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OpenPathButton"
                            Grid.Column="1"
                            Click="OpenPathButton_Click"
                            Style="{StaticResource FrostedDefaultButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE838;" FontSize="14"/>
                            <TextBlock Text="打开路径"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="EditButton"
                            Grid.Column="2"
                            Click="EditButton_Click"
                            Style="{StaticResource FrostedDefaultButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="40">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                            <TextBlock Text="编辑"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 第二行：归档（含进度） | 启动/下载/终止（含进度） -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" HorizontalAlignment="Stretch" Height="40">
                        <Button x:Name="ArchiveButton"
                                Click="ArchiveButton_Click"
                                Style="{StaticResource FrostedDefaultButtonStyle}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                <TextBlock Text="归档"/>
                            </StackPanel>
                        </Button>
                        <Grid x:Name="ArchiveProgressPanel" Visibility="Collapsed"
                              HorizontalAlignment="Stretch" Height="40">
                            <Border Background="White" Opacity="0.9" CornerRadius="4"/>
                            <Border x:Name="ArchiveFillBar" Background="#4CAF50" CornerRadius="4"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ArchiveFillScale" ScaleX="0" ScaleY="1"/>
                                </Border.RenderTransform>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressRing x:Name="ArchiveRing" IsActive="True" Width="14" Height="14"/>
                                <TextBlock x:Name="ArchiveProgressText" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#333333" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" Height="40">
                        <Button x:Name="LaunchButton"
                                Click="LaunchButton_Click"
                                Style="{StaticResource FrostedAccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                RenderTransformOrigin="0.5,0.5"
                                HorizontalContentAlignment="Center">
                            <Button.RenderTransform>
                                <ScaleTransform x:Name="LaunchScaleTransform" ScaleX="1" ScaleY="1"/>
                            </Button.RenderTransform>
                            <StackPanel x:Name="LaunchButtonContent" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon x:Name="LaunchButtonIcon" Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock x:Name="LaunchButtonText" Text="启动游戏"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton"
                                Click="StopButton_Click"
                                Style="{StaticResource FrostedStopButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Visibility="Collapsed"
                                RenderTransformOrigin="0.5,0.5"
                                HorizontalContentAlignment="Center">
                            <Button.RenderTransform>
                                <ScaleTransform x:Name="StopScaleTransform" ScaleX="0.5" ScaleY="0.5"/>
                            </Button.RenderTransform>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                                <TextBlock Text="终止游戏"/>
                            </StackPanel>
                        </Button>
                        <Grid x:Name="TransferProgressPanel2" Visibility="Collapsed"
                              HorizontalAlignment="Stretch" Height="40">
                            <Border Background="White" Opacity="0.9" CornerRadius="4"/>
                            <Border x:Name="TransferFillBar2" Background="#4CAF50" CornerRadius="4"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="TransferFillScale2" ScaleX="0" ScaleY="1"/>
                                </Border.RenderTransform>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressRing x:Name="TransferRing2" IsActive="True" Width="14" Height="14"/>
                                <TextBlock x:Name="TransferProgressText2" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#333333" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>