<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GameLauncher.Views.GameDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameLauncher.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="游戏详情"
    CloseButtonText="关闭"
    DefaultButton="Close">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
        <StackPanel Width="450" Spacing="16">

            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GameNameText" 
                               Text="{x:Bind GameName}" 
                               Style="{StaticResource TitleTextBlockStyle}" 
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" 
                        Width="48" 
                        Height="48" 
                        CornerRadius="4" 
                        VerticalAlignment="Center">
                                        <Image x:Name="GameIcon" 
                           Source="{x:Bind GameIconSource}" 
                           Stretch="Uniform"/>
                    </Border>
                </Grid>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="游戏描述" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <TextBlock x:Name="DescriptionText" 
                           Text="{x:Bind GameDescription, FallbackValue='暂无描述'}" 
                           TextWrapping="Wrap" 
                           Style="{StaticResource BodyTextBlockStyle}"/>
            </StackPanel>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    CornerRadius="4" 
                    Padding="12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                        <TextBlock Text="启动次数：" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind LaunchCount}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE916;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                        <TextBlock Text="游戏时长：" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind PlayTimeDisplay}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="添加时间：" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind CreatedTimeDisplay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="游戏预览" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        CornerRadius="4" 
                        MinHeight="100">
                    <Grid>
                        <GridView x:Name="PreviewImagesItemsControl"
                                  ItemsSource="{x:Bind ImageSources}"
                                  Padding="4"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/>
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="130" Height="80" Margin="4"
                                          Tapped="Image_Tapped"
                                          PointerEntered="Image_PointerEntered"
                                          PointerExited="Image_PointerExited">
                                        <Border CornerRadius="4" Clip="{Binding ElementName=InnerImage}"
                                                Background="{ThemeResource SystemChromeMediumColor}">
                                            <Image x:Name="InnerImage" Source="{Binding}" Stretch="UniformToFill"/>
                                        </Border>
                                        <Border CornerRadius="4" 
                                                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                                Opacity="0.8"
                                                Visibility="Collapsed"
                                                x:Name="HoverOverlay">
                                            <Grid>
                                                <FontIcon Glyph="&#xE8A3;" FontSize="24" 
                                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <Border x:Name="LargePreviewBorder"
                                CornerRadius="8"
                                Background="{ThemeResource SystemChromeMediumColor}"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="400"
                                MaxHeight="300"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Tapped="LargePreview_Tapped">
                            <Image x:Name="LargePreviewImage" 
                                   Source="{x:Bind LargeImageSource, Mode=OneWay}"
                                   Stretch="Uniform"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <Button x:Name="LaunchButton" 
                    Click="LaunchButton_Click" 
                    Style="{StaticResource AccentButtonStyle}" 
                    HorizontalAlignment="Stretch" 
                    Height="40"
                    Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="16"/>
                    <TextBlock Text="启动游戏"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>